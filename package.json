{
  "name": "consult-mcp",
  "version": "1.1.0",
  "mcpName": "io.github.neelsatyavolu/consult",
  "description": "Get a second opinion on your code from every coding agent you have. Claude Code, Codex and Grok review each other's diffs and answer each other's questions, even inside a session that's already running. Uses the CLIs you're signed in to, no API keys.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "codex",
    "grok",
    "ai-agents",
    "second-opinion",
    "code-review"
  ],
  "homepage": "https://getconsult.dev",
  "bugs": {
    "url": "https://github.com/neelsatyavolu/consult/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neelsatyavolu/consult.git"
  },
  "license": "MIT",
  "author": "Neel Satyavolu (https://n3el.dev)",
  "type": "module",
  "bin": {
    "consult": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "vitest run",
    "test:live": "CONSULT_LIVE=1 vitest run test/live.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "smol-toml": "^1.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
